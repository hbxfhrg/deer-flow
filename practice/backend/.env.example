# ============================================================================
# DeerFlow Practice Backend — 环境变量模板
# ============================================================================
#
# 使用方式:
#   cp .env.example .env
#   编辑 .env 中的实际值
#
# 注意：config.yaml 中的 api_key、password 等敏感字段也支持 ${ENV_VAR} 格式引用环境变量
# 例如: api_key: $Qwen_API_KEY

# 配置文件路径（可选，默认自动查找）
PRACTICE_CONFIG_PATH=

# 日志级别
LOG_LEVEL=INFO

# 服务端口
PORT=8001
